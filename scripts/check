#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "gofmt: these files need formatting:" >&2
  echo "$unformatted" >&2
  exit 1
fi
go vet ./...
golangci-lint run ./...
if [ "${1:-}" = "--quick" ]; then
  go test -timeout 120s ./...
else
  ./scripts/test
fi
